{"question_id": "1583", "paper_id": "503", "policy": "E1-QD", "evidence": {"text": "", "items": [], "rejected_items": [], "evidence_tokens": 0, "support_tokens": 0, "fact_tokens": 0, "num_supported_items": 0, "num_accepted_items": 0, "num_rejected_items": 0, "num_accepted_facts": 0, "num_rejected_facts": 0, "exact_span_support_rate": null, "accepted_exact_span_support_rate": null, "zero_exact_support": true, "invalid_format": true, "empty_extraction": false, "fail_closed": true, "failure_reason": "malformed_output", "extraction_valid": false, "reached_extraction_token_limit": false, "evidence_hash": "12ae32cb1ec02d01eda3581b127c1fee3b0dc53572ed6baf239721a03d82e126", "max_evidence_tokens": 128, "grounding_note": "Exact source support is mechanical, not semantic entailment. Facts are conservatively copied subspans, not free paraphrases."}, "raw_output": "[{\"source_chunk_id\": \"e24199b6da10f0fae1547068\", \"support_span\": \"Existing research efforts mostly regard this task as a sequence labeling problem, building models that can capture explicit structures in the output space. However, the importance of capturing implicit global structural information that resides in the input space is largely unexplored. In this work, we argue that both types of information (implicit and explicit structural information) are crucial for building a successful targeted sentiment analysis model. Our experimental results show that properly capturing both information is able to lead to better performance than competitive existing approaches. We also conduct extensive experiments to investigate our model's effectiveness and robustness.\"}]", "prompt_hash": "3dffa8080a9ecab79586af825bd782caa2aa4ad5f09d25a1e15e2ef0cc37697e", "extraction_calls": [{"stage": "extraction", "model_id": "mistralai/Mistral-7B-Instruct-v0.2", "model_revision": "b52c0e84decd72f68ff7fcaad4d9a5f8299d7115a535c077bc05df5afda6005b", "dtype": "torch.float16", "quantization": "none", "gpu": "NVIDIA TITAN RTX", "peak_memory