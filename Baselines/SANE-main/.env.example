# Copy this file to .env and fill in real values. .env is gitignored.
#
# Provider → env-var mapping:
#   DeepSeek (api.deepseek.com)  →  DS_API_KEY
#   vLLM                          →  VLLM_API_KEY, VLLM_BASE_URL
#   Embedding                     →  EMBED_API_KEY, EMBEDDING_BASE_URL
#
# The model name in your config YAML drives everything:
#   model: "deepseek-v4-flash"       →  DeepSeek, DS_API_KEY
#   model: "Qwen/Qwen3.5-4B"         →  vLLM, VLLM_API_KEY
#   model: "Qwen3-Embedding-0.6B"    →  Embedding, EMBED_API_KEY
#
# Each provider's base URL can be overridden via {PROVIDER}_BASE_URL.
# For example, set EMBEDDING_BASE_URL to point to your embedding server.

# DeepSeek API key
DS_API_KEY=your-deepseek-api-key-here

# vLLM API key + base URL (for all Qwen models)
VLLM_API_KEY=your-vllm-api-key-here
# VLLM_BASE_URL=https://your-vllm-host/v1

# Embedding API key + base URL
EMBED_API_KEY=your-embedding-api-key-here
# EMBEDDING_BASE_URL=https://your-embedding-host/v1

# Optional judge overrides
# JUDGE_MODEL=deepseek-v4-flash
# JUDGE_BASE_URL=https://api.deepseek.com
# JUDGE_API_KEY=your-judge-api-key-here
