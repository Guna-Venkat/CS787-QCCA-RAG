{
  "label": "POST_W12_EXPLORATORY",
  "version": "BEA-QBGF-v1.1-prepilot",
  "output_root": "results/post_w12/bea_qbgf/v3",
  "parent_config": "configs/week12/protocol.yaml",
  "methods": [
    "FIXED_SENTENCE",
