      "BEA_QBGF-FIXED_SENTENCE",
      "BEA_QBGF-QBGF_FULL"
    ]
  },
  "pilot_gate": {
    "qa_margin": 0.003,
    "macro_f1_margin": 0.01,
    "max_clearly_degraded_cells": 2,
    "min_different_context_fraction": 0.1,
    "min_upgrade_cell_fraction": 0.01,
